### dct properties:

:hasMin0MaxNShape-dctConformsTo a sh:PropertyShape;
   sh:name "conforms to"@en, "i samsvar med"@nb;
   sh:path dct:conformsTo;
   sh:class dct:Standard;
  sh:message "The property dct:conformsTo MUST refer to an instance of dct:Standard"@en,
      "Egenskapen dct:conformsTo SKAL referere til en instans av dct:Standard";
   sh:severity sh:Violation .

:hasMin0MaxNShape-dctCreator a sh:PropertyShape;
  sh:name "creator"@en, "produsent"@nb ;
  sh:path dct:creator;
  sh:or ( # tar med subklasser av foaf:Agent for å unngå feilmelding
      [sh:class foaf:Agent]
      [sh:class org:Organization]
      [sh:class foaf:Group] 
      [sh:class foaf:Person]
      [sh:class rov:RegisteredOrganization] );
  sh:message "The property dct:creator MUST refer to an instance of foaf:Agent or one of its subclass"@en ,
    "Egenskapen dct:creator SKAL referere til en instans av foaf:Agent eller en av dens subklasser"@nb ;
  sh:severity sh:Violation .

:hasMin1MaxNShape-dctDescription a sh:PropertyShape;
  sh:name "description"@en, "beskrivelse"@nb;
  sh:path dct:description;
  sh:datatype rdf:langString;
  sh:minCount 1;
  sh:message "The property dct:description MUST have min. 1 value which MUST be of datatype rdf:langString"@en ,
    "Egenskapen dct:description SKAL ha minst 1 verdi som SKAL være av datatype rdf:langString"@nb ;
  sh:severity sh:Violation .

:hasMin0Max1Shape-dctIdentifier a sh:PropertyShape;
  sh:name "identifier"@en, "identifikator"@nb ;
  sh:path dct:identifier;
  sh:nodeKind sh:IRIOrLiteral;
  sh:maxCount 1;
  sh:message "The property dct:identifier may have max. 1 value"@en, 
      "Egenskapen dct:identifier kan ha maks. 1 verdi"@nb ;
  sh:severity sh:Violation .

:hasMin0MaxNShape-dctIdentifier a sh:PropertyShape;
  sh:name "identifier"@en, "identifikator"@nb ;
  sh:path dct:identifier;
  sh:nodeKind sh:IRIOrLiteral;
  sh:message "The property dct:identifier MUST be a URI or Literal"@en, "Egenskapen dct:identifier SKAL være en URI eller Literal"@nb ;
  sh:severity sh:Violation .

:hasMin0MaxNShape-dctIsReferencedBy a sh:PropertyShape;
   sh:name "is referenced by"@en, "er referert av"@nb;
   sh:path dct:isReferencedBy;
   sh:nodeKind sh:IRI;
   sh:message "The property dct:isReferencedBy MUST be an IRI"@en, 
    "Egenskapen dct:isReferencedBy SKAL være en IRI"@nb ;
  sh:severity sh:Violation .

:hasMin0Max1Shape-dctIssued a sh:PropertyShape;
  sh:name "issued/release date"@en, "utgivelsesdato"@nb ;
  sh:path dct:issued;
  sh:or (
    [sh:datatype xsd:date]
    [sh:datatype xsd:dateTime] );
  sh:maxCount 1;
  sh:message "The property dct:issued may have max. 1 value which MUST be of datatype xsd:date or xsd:dateTime"@en, 
    "Egenskapen dct:issued kan ha maks. 1 verdi som SKAL være av datatype xsd:date eller xsd:dateTime"@nb ;
  sh:severity sh:Violation .

:hasMin0Max1Shape-dctModified a sh:PropertyShape;
   sh:name "modification date"@en, "endringsdato"@nb;
   sh:path dct:modified;
   sh:or (
      [sh:datatype xsd:date]
      [sh:datatype xsd:dateTime]
      );
   sh:maxCount 1;
  sh:message "The property dct:modified may have max. 1 value which MUST be of datatype xsd:date or xsd:dateTime"@en, 
    "Egenskapen dct:modified kan ha maks. 1 verdi som SKAL være av datatype xsd:date eller xsd:dateTime"@nb ;
  sh:severity sh:Violation .

:hasMin0MaxNShape-dctProvenance a sh:PropertyShape;
  sh:name "provenance"@en, "eierskapshistorikk"@nb ;
  sh:path dct:provenance;
  sh:class dct:ProvenanceStatement;
  sh:message "The property dct:provenance MUST refer to an instance of dct:ProvenanceStatement"@en, 
      "Egenskapen dct:provenance SKAL referere til en instans av dct:ProvenanceStatement"@nb ;
  sh:severity sh:Violation .
  
:hasMin1Max1Shape-dctPublisher a sh:PropertyShape;
  sh:name "publisher"@en, "utgiver"@nb ;
  sh:path dct:publisher;
  sh:or ( # tar med subklasser av foaf:Agent for å unngå feilmelding
      [sh:class foaf:Agent] 
      [sh:class org:Organization] 
      [sh:class foaf:Group] 
      [sh:class foaf:Person] );
  sh:minCount 1;
  sh:maxCount 1;
  sh:message "The property dct:publisher MUST have min. 1 and max. 1 value which MUST refer to an instance of foaf:Agent"@en ,
    "Egenskapen dct:publisher SKAL ha min. 1 og maks. 1 verdi som SKAL referere til en instans av foaf:Agent"@nb ;
  sh:severity sh:Violation .

:hasMin0MaxNShape-dctRelation a sh:PropertyShape;
   sh:name "related resource"@en, "relatert ressurs"@nb;
   sh:path dct:relation;
   sh:nodeKind sh:IRI;
   sh:message "The property dct:relation MUST refer to an instance of rdfs:Resource"@en,
      "Egenskapen dct:relation SKAL referere til en instans av rdfs:Resource"@nb;
   sh:severity sh:Violation .

:hasMin0MaxNShape-dctReplaces a sh:PropertyShape;
   sh:name "replaces"@en, "erstatter"@nb;
   sh:path dct:replaces;
   sh:class dcat:Dataset;
   sh:message "The property dct:replaces MUST refer to an instance of dcat:Dataset"@en,
      "Egenskapen dct:replaces SKAL referere til en instans av dcat:Dataset"@nb;
   sh:severity sh:Violation .

:hasMin0MaxNShape-dctSource a sh:PropertyShape;
   sh:name "source"@en, "kilde"@nb;
   sh:path dct:source;
   sh:class dcat:Dataset;
   sh:message "The property dct:source MUST refer to an instance of dcat:Dataset"@en,
      "Egenskapen dct:source SKAL referere til en instans av dcat:Dataset"@nb;
   sh:severity sh:Violation .

:hasMin0MaxNShape-dctSubject a sh:PropertyShape;
   sh:name "concept"@en, "begrep"@nb;
   sh:path dct:subject;
   sh:class skos:Concept;
   sh:message "The property dct:subject MUST refer to an instance of skos:Concept"@en,
      "Egenskapen dct:subject SKAL referere til en instans av skos:Concept"@nb;
   sh:severity sh:Warning . # Warning fordi mange begreper der ute ikke er kodet som skos:Concept

:hasMin0MaxNShape-dctTemporal a sh:PropertyShape;
  sh:name "temporal"@en, "tidsrom"@nb;
  sh:path dct:temporal;
  sh:class dct:PeriodOfTime;
  sh:minCount 1;
  sh:message "The property dct:temporal MUST refer to an instance of dct:PeriodOfTime"@en,
      "Egenskapen dct:temporal SKAL referere til en instans av dct:PeriodOfTime"@nb ;
  sh:severity sh:Violation .

:hasMin1MaxNShape-dctTitle a sh:PropertyShape;
  sh:name "title/name"@en, "tittel/navn"@nb;
  sh:path dct:title;
  sh:datatype rdf:langString;
  sh:minCount 1;
  sh:message "The property dct:title MUST have min. 1 value which MUST be of datatype rdf:langString"@en,
      "Egenskapen dct:title SKAL ha min. 1 verdi som SKAL være av datatype rdf:langString"@nb ;
  sh:severity sh:Violation .

:hasMin0MaxNShape-dctType  a sh:PropertyShape;
   sh:name "type"@en, "type"@nb;
   sh:path dct:type;
   sh:class skos:Concept;
   sh:message "The property dct:type MUST refer to an instance of skos:Concept"@en,
      "Egenskapen dct:type SKAL referere til en instans av skos:Concept"@nb;
   sh:severity sh:Warning . # Warning fordi mange begreper der ute ikke er kodet som skos:Concept

