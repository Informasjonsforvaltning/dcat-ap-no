@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix spdx: <http://spdx.org/rdf/terms#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcatap: <http://data.europa.eu/r5r> .
@prefix breg: <http://data.europa.eu/breg> .
@prefix cpsv: <http://purl.org/vocab/cpsv#> .
@prefix eli: <http://data.europa.eu/eli/ontology#> .
@prefix cv: <http://data.europa.eu/m8g/> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .

@prefix : <https://data.norge.no/vocabulary/dcatno-shacl#> .

# About this SHACL:
<https://data.norge.no/specification/dcat-ap-no/#shacl>
    dcat:accessURL <https://github.com/Informasjonsforvaltning/dcat-ap-no/tree/develop/shacl>;
    dcat:downloadURL <https://raw.githubusercontent.com/Informasjonsforvaltning/dcat-ap-no/refs/heads/develop/shacl/DCAT-AP-NO-shacl_shapes_3.ttl> ;
